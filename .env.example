# PostgreSQL — Supabase (Transaction pooler — used by Prisma at runtime)
# Found in: Supabase Dashboard → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# PostgreSQL — Supabase (Direct connection — used by Prisma for migrations)
# Found in: Supabase Dashboard → Project Settings → Database → Connection string → Direct connection
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase — project URL and service-role key (for Storage uploads)
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"   # Keep this server-side only — never expose to the browser

JWT_SECRET="your_production_jwt_secret_change_me"
ADMIN_INITIAL_EMAIL="admin@fashionhub.com"
ADMIN_INITIAL_PASSWORD="admin123"
NEXT_PUBLIC_APP_URL="https://your-app-name.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="2349037381538"
CLEANUP_SECRET="replace_with_a_long_random_secret"

# Email (Nodemailer) — used to send order confirmation emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Cheren Fashion Studio <your@gmail.com>"
